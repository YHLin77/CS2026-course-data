      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4db20660-9489-4e62-ad31-588649fd160c",
              "name": "system_prompt",
              "value": "={{ \n`## 回傳格式\n只輸出 JSON，禁止任何額外文字、解釋。個別變數的標註結果必須嚴格遵守規範的格式，不要輸出多餘的說明。\n請嚴格遵守以下回傳格式:\n{\n  \"annotations\": [\n    {\n      \"review_id\": string,\n      \"frame\": 0|1|2|3,\n      \"frame_reason\": string,\n      \"hist_engagement\": 0|1|2,\n      \"tj_truth\": 0|1,\n      \"tj_victim\": 0|1,\n      \"tj_perpetrator\": 0|1,\n      \"tj_recurrence\": 0|1,\n      \"tj_values\": 0|1,\n      \"auth_attitude\": 0|1|2|3,\n      \"auth_attitude_reason\": string,\n      \"personal_nostalgia\": 0|1,\n      \"pos\": 0|1,\n      \"neg\": 0|1,\n      \"supernatural\": 0|1,\n      \"guidance_mention\": 0|1,\n      \"guidance_eval\": 1|2|3|9,\n      \"note\": string\n    }\n  ]\n}`\n}}",
              "type": "string"
            },
            {
              "id": "449e3911-3bbe-4780-900b-e069b17601c2",
              "name": "reason_llm",
              "value": "={{\n\"除了編碼簿中的變數外，請再分別針對每一則個別評論內容，以繁體中文提供你標註 frame, auth_attitude 的理由，用一句話說明，分別紀錄於 frame_reason, auth_attitude_reason 變數。注意不要混淆不同評論內容的標註理由。\"\n}}",
              "type": "string"
            },
            {
              "id": "27452204-2120-44c4-865e-ee9078940aeb",
              "name": "variables",
              "value": "={{\n [\"frame\", \"frame_reason\", \"hist_engagement\", \"tj_truth\", \"tj_victim\", \"tj_perpetrator\", \"tj_recurrence\", \"tj_values\", \"auth_attitude\", \"auth_attitude_reason\", \"personal_nostalgia\", \"pos\", \"neg\", \"supernatural\", \"guidance_mention\", \"guidance_eval\", \"note\"]\n}}",
              "type": "string"
            },
            {
              "id": "065c9251-6307-46c0-a162-c58644e57229",
              "name": "drive_folder_id",
              "value": "1fJGvpihXGc7TfSehjUNBktsn4up1_yJC",
