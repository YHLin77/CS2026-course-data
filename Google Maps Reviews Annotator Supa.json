    {
      "parameters": {
        "jsCode": "const systemPrompt = $('Set-up Configurations').first().json.system_prompt;\nconst reasonPrompt = $('Set-up Configurations').first().json.reason_llm;\nconst processedItems = $input.all();\n\n// codebook 只取一次（所有筆共用）\nconst codebookText = processedItems[0].json.content;\n\n// 組合多筆評論內容\nconst reviewsText = processedItems.map((item) => {\n  const row = item.json;\n  return `### place_name: ${row.place_name} | review_id: ${row.review_id}\\n${row.text}`;\n}).join('\\n\\n');\n\nconst annotatePrompt = `你是一位Google Map評論內容標註人員，請認真依照編碼簿的規則，對每一則評論內容進行標註。如果你一次收到多則評論，請獨立標註每一則評論內容，不要受到其他評論影響，並且請請完全依照評論內容輸入的順序，輸出標註的結果。\n\n## 編碼簿\n${codebookText}\n${reasonPrompt}\n\n## 待標註評論內容（共 ${processedItems.length} 則）\n${reviewsText}\n`;\n\nconst firstRow = processedItems[0].json;\n\nreturn [{\n  json: {\n    sheet: firstRow.sheet,\n    model: firstRow.model_key,\n    review_ids: processedItems.map(item => item.json.review_id), \n    requestBody: {\n      systemInstruction: {\n        parts: [\n          { text: systemPrompt }\n        ]\n      },\n      contents: [\n        {\n          role: \"user\",\n          parts: [\n            { text: annotatePrompt }\n          ]\n        }\n      ],\n      generationConfig: {\n        temperature: 0,\n        maxOutputTokens: 8192,\n        responseMimeType: \"application/json\"\n      }\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2496,
        192
      ],
      "id": "391136c3-e43d-40d6-8a54-b2385d2fb951",
