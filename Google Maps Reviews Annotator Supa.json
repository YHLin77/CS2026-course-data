    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nconst config = $('Set-up Configurations').first().json;\nconst reviewIds = $('Prompt Gemini-12').first().json.review_ids ?? [];\n\nfunction toArray(val) {\n  if (Array.isArray(val)) return val;\n  if (typeof val === 'string' && val.trim() !== '') {\n    try { return JSON.parse(val); } catch { return []; }\n  }\n  return [];\n}\n\nfunction extractJSON(text) {\n  const fenced = text.match(/```json\\s*([\\s\\S]*?)```/);\n  if (fenced) return fenced[1].trim();\n  const braceMatch = text.match(/(\\{[\\s\\S]*\\}|\\[[\\s\\S]*\\])/);\n  if (braceMatch) return braceMatch[1].trim();\n  return null;\n}\n\nconst variables = toArray(config.variables);\nconst allFields = [...variables];\n\nfor (const item of items) {\n  const data = item.json;\n\n  const content = data?.candidates?.[0]?.content?.parts?.[0]?.text;\n  if (!content) {\n    out.push({ json: { error: \"No content in candidates[0].content.parts[0].text\", raw: data } });\n    continue;\n  }\n\n  const extracted = extractJSON(content);\n  if (!extracted) {\n    out.push({ json: { error: \"No JSON found in content\", content, raw: data } });\n    continue;\n  }\n\n  let parsed;\n  try {\n    parsed = JSON.parse(extracted);\n  } catch (e) {\n    out.push({ json: { error: \"Failed to parse JSON\", content, extracted, raw: data } });\n    continue;\n  }\n\n  const annotations = parsed.annotations ?? [];\n  for (let i = 0; i < annotations.length; i++) {\n    const ann = annotations[i];\n    const row = {\n      review_id: reviewIds[i] ?? null,\n      review_id_llm: ann.review_id ?? null, \n      model: $input.first().json.modelVersion ?? null\n    };\n    for (const field of allFields) {\n      row[field] = ann[field] ?? null;\n    }\n    out.push({ json: row });\n  }\n}\n\nreturn out;"
      },
