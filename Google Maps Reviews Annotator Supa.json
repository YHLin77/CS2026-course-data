    {
      "parameters": {
        "jsCode": "const systemPrompt = $('Set-up Configurations').first().json.system_prompt;\nconst reasonPrompt = $('Set-up Configurations').first().json.reason_llm;\nconst processedItems = $input.all();\n\n// codebook 每筆共用\nconst codebookText = processedItems[0].json.content;\n\n// 組合多筆評論內容\nconst reviewsText = processedItems.map((item) => {\n  const row = item.json;\n  return `### place_name: ${row.place_name} | review_id: ${row.review_id} \\n\\n ${row.text}`;\n}).join('\\n\\n');\n\nconst firstRow = processedItems[0].json;\n\nreturn [{\n  json: {\n    sheet: firstRow.sheet,\n    model: firstRow.model_key,\n    review_ids: processedItems.map(item => item.json.review_id),\n    requestBody: {\n      model: \"claude-haiku-4-5-20251001\",\n      system: [\n        {\n          type: \"text\",\n          text: systemPrompt,\n          cache_control: { type: \"ephemeral\" }\n        }\n      ],\n      messages: [\n        {\n          role: \"user\",\n          content: [\n            {\n              type: \"text\",\n              text: `你是一位Google Map評論內容標註人員，請認真依照編碼簿的規則，對每一則評論內容進行標註。如果你一次收到多則評論，請獨立標註每一則評論內容，不要受到其他評論影響，並且請請完全依照評論內容輸入的順序，輸出標註的結果。輸出的 annotations 陣列長度必須剛好等於輸入評論則數,review_id 必須逐字複製自輸入,禁止重複任何 review_id。\\n\\n ## 編碼簿 \\n\\n${codebookText}\\n\\n${reasonPrompt}`,\n              cache_control: { type: \"ephemeral\" }\n            },\n            {\n              type: \"text\",\n              text: `## 待標註評論內容（共 ${processedItems.length} 則）\\n${reviewsText}`\n            }\n          ]\n        }\n      ],\n      temperature: 0,\n      max_tokens: 8192\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2512,
        512
      ],
      "id": "400676d5-a1d9-4153-b531-45060ce147f0",
      "name": "Prompt Haiku-5"
