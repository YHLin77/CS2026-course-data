    {
      "parameters": {
        "jsCode": "const lastScraped = $('Query Last Review Date').first().json.last_scraped;\n\nconst input = {\n  placeIds: [$('Update Scrape Time').first().json.place_id],\n  maxReviews: 3000,\n  reviewsSort: \"newest\", // or \"mostRelevant\"\n  language: \"zh-TW\",\n  reviewsOrigin: \"all\",\n  personalData: true\n};\n\n// 持續蒐集: 以目前資料庫中最新一則評論發布時間為起點\nif (lastScraped) {\n   input.reviewsStartDate = lastScraped;\n}\n// 如果 reviewsSort: \"mostRelevant\" 則不需要此變數\n\nreturn [{ json: { apifyInput: input } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
        144
      ],
