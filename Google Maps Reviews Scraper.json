    {
      "parameters": {
        "jsCode": "const totalReviews = $input.first().json.data.itemCount;\nconst datasetId = $input.first().json.data.id;\nconst batchSize = 1000;\nconst batches = Math.ceil(totalReviews / batchSize);\n\nif (batches === 0) {\n  return [{ json: { totalReviews: 0, datasetId: datasetId } }];\n}\n\nconst result = [];\nfor (let i = 0; i < batches; i++) {\n  result.push({\n    json: {\n      offset: i * batchSize,\n      limit: batchSize,\n      datasetId: datasetId,\n      totalReviews: totalReviews\n    }\n  });\n}\n\nreturn result;"
      },
